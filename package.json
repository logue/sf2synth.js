{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logue/sf2synth",
  "version": "0.10.2",
  "type": "module",
  "description": "SoundFont2 Synthesizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logue/sf2synth.js.git"
  },
  "keywords": [
    "midi",
    "WebMidiLink",
    "wml",
    "sf2",
    "soundfont",
    "synthesizer",
    "webaudio",
    "gm",
    "xg",
    "gs"
  ],
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev"
  },
  "contributors": [
    {
      "name": "imaya / GREE Inc.",
      "url": "https://github.com/gree"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/logue/sf2synth.js/issues"
  },
  "homepage": "https://github.com/logue/sf2synth.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/sf2synth.css": "./dist/sf2synth.css",
    "./dist/Yamaha XG Sound Set.sf2": "./dist/Yamaha XG Sound Set.sf2",
    "./dist/Yamaha XG Sound Set Ver.2.0.sf2": "./dist/Yamaha XG Sound Set Ver.2.0.sf2",
    "./dist/SoundFont Copyright.txt": "./dist/SoundFont Copyright.txt",
    "./dist/A320U.sf2": "./dist/A320U.sf2",
    "./dist/A320U-license.txt": "./dist/A320U-license.txt"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@11.22.0",
  "sideEffects": false,
  "scripts": {
    "dev": "rslib --watch",
    "dev:docs": "rsbuild",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rslint .",
    "lint:biome": "biome check --write",
    "inspect": "rslib inspect",
    "inspect:docs": "rsbuild inspect",
    "build": "rslib build",
    "build:docs": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf dist docs",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "dependencies": {
    "@logue/reverb": "^1.6.2",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@microsoft/api-extractor": "^7.58.12",
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.8.0",
    "@rstest/adapter-rslib": "^0.11.8",
    "@rstest/core": "^0.11.8",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.2.0",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
