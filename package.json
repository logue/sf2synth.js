{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logue/sf2synth",
  "version": "0.10.0",
  "type": "module",
  "description": "SoundFont2 Synthesizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logue/sf2synth.js.git"
  },
  "keywords": [
    "midi",
    "WebMidiLink",
    "wml",
    "sf2",
    "soundfont",
    "synthesizer",
    "webaudio",
    "gm",
    "xg",
    "gs"
  ],
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev"
  },
  "contributors": [
    {
      "name": "imaya / GREE Inc.",
      "url": "https://github.com/gree"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/logue/sf2synth.js/issues"
  },
  "homepage": "https://github.com/logue/sf2synth.js",
  "files": [
    "dist"
  ],
  "main": "dist/sf2synth.umd.js",
  "module": "dist/sf2synth.es.js",
  "browser": "dist/sf2synth.umd.js",
  "types": "dist/sf2synth.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sf2synth.es.js",
      "types": "./dist/sf2synth.d.ts",
      "require": "./dist/sf2synth.umd.js",
      "default": "./dist/sf2synth.es.js"
    },
    "./umd": {
      "default": "./dist/sf2synth.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/sf2synth.css": "./dist/sf2synth.css",
    "./dist/Yamaha XG Sound Set.sf2": "./dist/Yamaha XG Sound Set.sf2",
    "./dist/Yamaha XG Sound Set Ver.2.0.sf2": "./dist/Yamaha XG Sound Set Ver.2.0.sf2",
    "./dist/SoundFont Copyright.txt": "./dist/SoundFont Copyright.txt",
    "./dist/A320U.sf2": "./dist/A320U.sf2",
    "./dist/A320U-license.txt": "./dist/A320U-license.txt"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "rsbuild",
    "dev:lib": "rslib --watch",
    "skills:update": "npx skills update",
    "lint": "run-s lint:*",
    "lint:rslint": "rslint --fix .",
    "lint:biome": "biome format --write",
    "lint:prettier": "prettier \"./**/*.{yaml,css,sass,scss,htm,html,md}\" -w -u",
    "build:docs": "rsbuild build",
    "build": "run-s build:lib build:dts",
    "build:lib": "rslib build",
    "build:dts": "dts-bundle-generator --project ./tsconfig.app.json --no-banner -o dist/sf2synth.d.ts src/index.ts",
    "preview": "rsbuild preview",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "prepare": "husky install"
  },
  "dependencies": {
    "@logue/reverb": "^1.5.2",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@rsbuild/core": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.0",
    "@rslib/core": "^0.23.0",
    "@rslint/core": "^0.6.3",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/node": "^26.0.1",
    "dts-bundle-generator": "^9.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.8.5",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,json,htm,html,md}": "pnpm run lint"
  }
}
