{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logue/sf2synth",
  "version": "0.4.6",
  "type": "module",
  "description": "SoundFont2 Synthesizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logue/sf2synth.js.git"
  },
  "keywords": [
    "midi",
    "WebMidiLink",
    "wml",
    "sf2",
    "soundfont",
    "synthesizer",
    "webaudio",
    "gm",
    "xg",
    "gs"
  ],
  "author": {
    "name": "imaya / GREE Inc.",
    "url": "https://github.com/gree"
  },
  "contributors": [
    {
      "name": "Logue",
      "email": "logue@hotmail.co.jp",
      "url": "https://logue.dev"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/logue/sf2synth.js/issues"
  },
  "homepage": "https://github.com/logue/sf2synth.js",
  "files": [
    "dist"
  ],
  "main": "dist/sf2synth.umd.js",
  "module": "dist/sf2synth.es.js",
  "style": "dist/style.css",
  "exports": {
    ".": {
      "import": "./dist/sf2synth.es.js",
      "require": "./dist/sf2synth.umd.js"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    },
    "./dist/wml.html": "./dist/wml.html"
  },
  "engines": {
    "node": ">=16.16.0",
    "yarn": ">=1.22.10"
  },
  "packageManager": "yarn@3.2.3",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf node_modules/.vite",
    "build": "vite build",
    "build:docs": "vite build --config vite.config.docs.js",
    "build:clean": "rimraf dist",
    "lint": "eslint . --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint && prettier . --write",
    "lint:style": "stylelint \"./**/*.{css,sass,scss,htm,html}\" --fix --cache-location ./node_modules/.vite/vite-plugin-stylelint",
    "preview": "vite preview --config vite.config.docs.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "@logue/reverb": "^1.0.1",
    "bootstrap": "^5.2.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "eslint": "^8.23.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "query-string": "^7.1.1",
    "rimraf": "^3.0.2",
    "sass": "^1.54.6",
    "stylelint": "^14.11.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-recommended-scss": "^7.0.0",
    "stylelint-order": "^5.0.0",
    "stylelint-prettier": "^2.0.0",
    "vite": "^3.0.9",
    "vite-plugin-banner": "^0.4.0",
    "vite-plugin-checker": "^0.5.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json,htm,html,md}": "eslint . --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint",
    "*.{css,sass,scss,htm,html}": "stylelint --fix --cache --cache-location ./node_modules/.vite/vite-plugin-stylelint",
    "*": "prettier -w -u"
  },
  "resolutions": {
    "prettier": "^2.7.1"
  }
}
