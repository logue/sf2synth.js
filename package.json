{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logue/sf2synth",
  "version": "0.3.10",
  "description": "SoundFont2 Synthesizer",
  "scripts": {
    "dev": "webpack --mode development",
    "prod": "webpack --mode production",
    "serve": "webpack-dev-server --color --mode development",
    "lint": "eslint --cache . --fix && prettier . -w -u",
    "prepare": "husky install"
  },
  "main": "bin/sf2.synth.min.js",
  "bin": {
    "sf2synth": "bin/sf2.synth.min.js",
    "sf2parser": "bin/sf2.parser.min.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logue/sf2synth.js.git"
  },
  "keywords": [
    "midi",
    "WebMidiLink",
    "wml",
    "sf2",
    "soundfont",
    "synthesizer",
    "webaudio",
    "gm",
    "xg",
    "gs"
  ],
  "author": {
    "name": "imaya / GREE Inc.",
    "url": "https://github.com/gree"
  },
  "contributors": [
    {
      "name": "Logue",
      "email": "logue@hotmail.co.jp",
      "url": "https://logue.dev"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/logue/sf2synth.js/issues"
  },
  "homepage": "https://github.com/logue/sf2synth.js",
  "dependencies": {
    "@logue/reverb": "^0.5.2",
    "axios": "^0.26.1",
    "bootstrap": "^5.1.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.6",
    "@babel/core": "^7.17.9",
    "@babel/preset-env": "^7.16.11",
    "babel-loader": "^8.2.4",
    "copy-webpack-plugin": "^10.2.4",
    "core-js": "^3.21.1",
    "css-loader": "^6.7.1",
    "css-minimizer-webpack-plugin": "^3.4.1",
    "eslint": "^8.12.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^7.0.4",
    "mini-css-extract-plugin": "^2.6.0",
    "prettier": "^2.6.2",
    "sass": "1.50.0",
    "sass-loader": "^12.6.0",
    "terser-webpack-plugin": "^5.3.1",
    "webpack": "^5.71.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.8.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json,htm,html,md}": "eslint --fix --cache",
    "*": "prettier -w -u"
  }
}
