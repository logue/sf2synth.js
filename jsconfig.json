{
  "$schema": "https://json.schemastore.org/jsconfig",
  "compilerOptions": {
    "module": "es6",
    "target": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "checkJs": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["webmidi", "node"]
  },
  "exclude": ["node_modules"]
}
