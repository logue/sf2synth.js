{
  "extends": "./tsconfig.rslib.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src-docs/**/*"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "ESNext"
    ],
    "outDir": "docs",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "rootDir": "./",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.rsbuild.tsbuildinfo",
    "types": [
      "@rsbuild/core/types",
      "node"
    ]
  }
}
